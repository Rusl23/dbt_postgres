[sqlfluff]
dialect = postgres
templater = dbt
max_line_length = 400
indent_unit = space
tab_space_size = 4
exclude_paths = dbt_dwh/target/*, dbt_dwh/dbt_packages/*

[sqlfluff:templater:dbt]
project_dir = dbt_dwh
profiles_dir = ~/.dbt
profile = dbt_dwh
target = dev

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper
